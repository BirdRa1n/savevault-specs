{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://saveforge.github.io/saveforge-specs/schemas/common/defs.v1.schema.json",
  "title": "SaveForge shared definitions v1",
  "description": "Reusable definitions referenced by the other SaveForge schemas.",
  "$defs": {
    "sha256": {
      "description": "Lower-case hexadecimal SHA-256 digest.",
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "description": "UUID in canonical textual form. Producers SHOULD use UUIDv7 so identifiers sort by creation time.",
      "type": "string",
      "format": "uuid"
    },
    "timestamp": {
      "description": "RFC 3339 date-time. Producers MUST emit UTC with the Z suffix.",
      "type": "string",
      "format": "date-time"
    },
    "semver": {
      "description": "Semantic version (MAJOR.MINOR.PATCH with optional pre-release).",
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "slug": {
      "description": "Stable identifier: lower-case ASCII letters and digits separated by single hyphens.",
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "templatePath": {
      "description": "Path template that starts with a placeholder and uses '/' as separator. Full rules: profile/path-rules.md.",
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^<[A-Za-z]+>(/[^/]+)*$"
    },
    "os": {
      "description": "Operating system family.",
      "type": "string",
      "enum": ["windows", "linux", "macos"]
    },
    "store": {
      "description": "Game store or launcher that installed the game.",
      "type": "string",
      "enum": ["steam", "epic", "gog", "heroic", "lutris", "itch", "ea", "ubisoft", "battlenet", "amazon", "manual", "other"]
    },
    "base64": {
      "description": "Standard base64 (RFC 4648 section 4) with padding.",
      "type": "string",
      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
    }
  }
}
